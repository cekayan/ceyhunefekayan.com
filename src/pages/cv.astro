---
import Base from '@/layouts/Base.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import { site, education, experience, publications, type CvEntry } from '@/data/site';

const sections: { title: string; entries: CvEntry[] }[] = [
  { title: 'Education', entries: education },
  { title: 'Experience', entries: experience },
];
---

<Base title='CV'>
  <div class='page-head'>
    <h1>Curriculum Vitae</h1>
    <a class='button' href={site.cvPdf}>Download PDF</a>
  </div>

  {
    sections.map((s) => (
      <>
        <h2>{s.title}</h2>
        <ul class='dated'>
          {s.entries.map((e) => (
            <li class='cv-entry'>
              <span class='date'>{e.dates}</span>
              <div>
                <div class='title'>{e.title}</div>
                <div class='org'>{e.org}</div>
                {e.details && (
                  <ul>
                    {e.details.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      </>
    ))
  }

  <h2>Publications</h2>
  <ul class='pubs'>
    {publications.map((pub) => <PublicationItem pub={pub} />)}
  </ul>
  <p class='footnote'>* Equal contribution.</p>
</Base>
