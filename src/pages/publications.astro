---
import Base from '@/layouts/Base.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import { links, publications } from '@/data/site';

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
---

<Base title='Publications'>
  <h1>Publications</h1>
  <p class='subtitle'>
    * Equal contribution. Also on <a href={links.scholar}>Google Scholar</a>.
  </p>
  {
    years.map((year) => (
      <>
        <div class='year-heading'>{year}</div>
        <ul class='pubs'>
          {publications
            .filter((p) => p.year === year)
            .map((pub) => (
              <PublicationItem pub={pub} />
            ))}
        </ul>
      </>
    ))
  }
</Base>
